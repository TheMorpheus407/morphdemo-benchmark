s_common: .asciz "#version 130\nfloat c(float B){return fract(sin(B*78.233)*43758.5453);}"
s_img: .asciz "uniform float i;float l,u,K,I,m,k,A;vec3 H;float v(vec3 g){vec3 e=floor(g),f=g-e;f=f*f*(3.-2.*f);float a=e.x+e.y*57.+e.z*113.;return mix(mix(mix(c(a),c(a+1.),f.x),mix(c(a+57.),c(a+58.),f.x),f.y),mix(mix(c(a+113.),c(a+114.),f.x),mix(c(a+170.),c(a+171.),f.x),f.y),f.z);}float E(vec3 g){vec3 o=floor(g),w=g-o-.5;float p=dot(o,vec3(1,57,113)),b=0.;ivec2 d=ivec2(o.x+15.,2.-o.y);if(o.z==K&&d.x>=0&&d.x<30&&d.y>=0&&d.y<5&&d.x%6<5)b=float(int[5](18405233,15255086,18136623,1097263,18415153)[d.x/6]>>(d.x%6+d.y*5)&1)*step(float(d.x),l*4.-400.);m=smoothstep(0.,.3,u*1.3-v(o*.21));float q=step(c(p+.5),i*i*.002+m);I=max(max(b*(1.+A),q*(1.-m)*(.2+.8*c(p+floor(i*9.)))*(.5+A)),m*step(.97,c(p+floor(l*4.)*.37))*exp(-fract(l*4.)*3.));float J=length(w-sin(vec3(c(p),c(p+.1),c(p+.2))*6.28+i*(.6+c(p+.3)))*.3*(1.-m))-.04-.11*m-.13*b+1.-q;J=min(J,min(length(w.xy),min(length(w.yz),length(w.zx)))+.97-smoothstep(.6,1.,m));return max(min(J,.3),K-g.z);}void main(){l=i*32./15.;u=smoothstep(32.,64.,l);A=exp(-fract(l)*4.)*step(32.,l);k=step(96.,l);float y=70.*smoothstep(0.,1.,pow(min(i/45.,1.),1.7))-19.*k+(i-45.)*k*.1,s=.5*sin(i*.17)*(1.-k)+.05*k,h=0.,n,t=0.,f=0.,e=0.;H=vec3(-.5*k,-.5*k,y);K=mix(-99.,70.,k);vec2 x=(gl_FragCoord.xy-vec2(960,540))/540.;x.y=-x.y;vec3 D=normalize(vec3(x*mat2(cos(s),sin(s),-sin(s),cos(s)),1.6-.12*A)),g;D.xy+=.2*vec2(sin(i*.31),cos(i*.23))*(1.-k);s=.6*sin(i*.4)*u*(1.-k);D.xz*=mat2(cos(s),sin(s),-sin(s),cos(s));for(;e<220.;e++){g=H+D*h;n=E(g);t+=I*n*exp(-n*30.);f+=(1.-m)*max(0.,v(g*.5+i*.06)+.5*v(g*1.3-i*.1)-.8)*n;if(n<.001*h||h>70.)break;h+=n*.8;}vec3 z=mix(vec3(.45,.65,1.),vec3(1.,.5,.12),u),L=vec3(.01,.02,.04)*(1.+A)+z*.3*u*(1.-k)*exp(-2.*dot(x,x)),j=L,N=normalize(vec3(.5,.7,-.6));if(n<.001*h){float R=m,P=I,r=exp(-.7*abs(g.z-H.z-2.-28.*fract(l)))*step(32.,l)*(1.-k)*m;vec2 p=vec2(.002,0);vec3 a=normalize(vec3(E(g+p.xyy),E(g+p.yxy),E(g+p.yyx))-n);j=mix(L,(vec3(.45,.52,.64)*(1.+A)+z*r*9.)*(max(0.,dot(a,N))*.7+.1)*(1.-e/220.)+pow(1.+dot(D,a),3.)*(vec3(.2,.4,.8)+z*(t*40.+r*3.))+pow(max(0.,dot(reflect(D,a),N)),24.)*.7,exp(-h*(.05+.1*k)))+z*P*4.;}j+=z*t*40.;j=mix(j,vec3(.16,.2,.28),(1.-exp(-f*1.2))*smoothstep(3.,14.,i));j+=z*(exp(-max(l-96.,0.)*1.5)*k+exp(-max(l-112.,0.)*3.)*step(112.,l)*.5);j=1.-exp(-j*1.6);j=j*j*(3.-2.*j);j=mix(j,vec3(c(dot(gl_FragCoord.xy,vec2(.37,.91))+i*7.))*.7,.95*exp(-i*.6)+.03);j*=(1.-.15*dot(x,x))*smoothstep(60.,57.5,i)*smoothstep(0.,.5,i);gl_FragColor=vec4(pow(max(j,0.),vec3(.4545)),1);}"
s_snd: .asciz "vec2 F(float f,float B,float Q){vec2 g=6.2832*f*B*vec2(.997,1.003);return sin(g+Q*sin(g));}void main(){float a=floor(gl_FragCoord.x)+4096.*floor(gl_FragCoord.y),h=floor(a/5625.),B=(a-h*5625.)/48.e3,w=floor(a/22500.),C=(a-w*22500.)/48.e3,O=floor(a/11250.),y=(a-O*11250.)/48.e3,o=min(floor(a/18.e4),14.),r=(a-o*18.e4)/48.e3,b=a/9.e4,u=smoothstep(2.,8.,b),M=step(8.,b)*step(b,30.),m=exp(-C*9.)*M,f=110.*exp2(vec4(0,-4,-9,-2)[int(mod(o,4.))]/12.),t,d;vec3 G=vec3[4](vec3(0,3,7),vec3(0,3,8),vec3(-2,3,7),vec3(-2,2,5))[int(mod(o,4.))];vec2 v=vec2(c(a-h*5625.)-c(a-h*5625.+1.),c(a-h*5625.+.5)-c(a-h*5625.+1.5)),n,q=vec2(0);n=vec2(sin(6.2832*(52.*C+8.*(1.-exp(-C*28.))))*min(1.,C*400.)*exp(-C*8.)*M*.5+sin(6.2832*f*(1.+mod(O,2.))*y+2.5*exp(-y*8.)*sin(6.2832*f*y))*min(1.,y*300.)*exp(-y*4.)*(1.-m)*smoothstep(10.,12.,b)*step(b,30.)*.22);n+=v*exp(-B*(60.-35.*mod(h,2.)))*step(16.,b)*step(b,30.)*.12;q+=v*exp(-C*24.)*mod(w,2.)*step(16.,b)*step(b,30.)*.2;t=220.*exp2((G[int(mod(h,3.))]+12.*mod(floor(h/3.),2.)+12.*step(24.,b)+(1.-u)*24.*(c(h)-.5))/12.);d=B-(1.-u)*.1*c(h+.3);if(d>0.)q+=F(t,d,3.*exp(-d*14.))*(.6+.4*sin(vec2(0,1.57)+h))*exp(-d*(9.-4.*u))*min(1.,d*400.)*smoothstep(1.,6.,b)*(.4+.6*smoothstep(14.,17.,b))*step(b,30.)*.16;for(int e=0;e<3;e++)q+=(F(220.*exp2(G[e]/12.),r,1.2)+.5*F(440.*exp2(G[e]/12.),r,.8))*sin(3.1416*min(r/3.75,1.))*(1.-.6*m)*smoothstep(6.,10.,b)*.07;q+=F(440.*exp2(vec4(7,8,7,5)[int(mod(o,4.))]/12.),r,.6+.4*sin(r*5.))*(1.-exp(-r*6.))*exp(-r*.4)*step(16.,b)*.07;d=clamp(b/6.-.33,0.,1.);for(float e=0.;e<24.;e++){t=150.*exp2(4.*c(e+.7));q+=sin(6.2832*(t*a/48.e3+(110.*floor(1.+e/3.)-t)*1.875*(6.*(d*d*d-d*d*d*d*.5)+max(0.,b-8.))+c(e))+vec2(0,e))*(1.-smoothstep(7.,10.,b))*smoothstep(0.,2.,b)*.022;}q+=v*pow(fract(b/8.),6.)*step(b,25.)*.13;gl_FragColor=vec4(n,q)*smoothstep(32.,30.,b)*.75;}"
